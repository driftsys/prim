root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
max_line_length = 80

prim_mdlint_strict = false
[*.{json,yaml,yml,toml}]
indent_size = 2

[*.rs]
indent_size = 4

[Makefile]
indent_style = tab

[justfile]
indent_size = 4
[docs/**.md]
prim_mdlint_strict = true
[docs/wip/**.md]
prim_mdlint_strict = false
[docs/archive/**.md]
prim_mdlint_strict = false
[**/SUMMARY.md]
prim_mdlint_strict = false
